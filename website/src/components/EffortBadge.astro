---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<span class="badge">{label}</span>

<style>
  .badge {
    display: inline-block;
    background: var(--badge-bg);
    color: var(--badge-text);
    border-radius: var(--radius-pill);
    padding: 0.15rem var(--space-3);
    font-size: var(--text-caption);
    font-weight: 700;
    line-height: 1.5;
  }
</style>
