---
// Shell only. Provider wiring is Phase 5.
interface Props {
  action?: string;
  heading?: string;
  id?: string;
}

const { action, heading = 'Get new recipes by email', id = 'signup' } = Astro.props;
---

<section id={id} class="no-print" aria-labelledby={`${id}-h`}>
  <h2 id={`${id}-h`}>{heading}</h2>
  <form class="form" method="post" action={action}>
    <div>
      <label for={`${id}-email`}>Email address</label>
      <input id={`${id}-email`} name="email" type="email" autocomplete="email" required />
    </div>
    <button class="btn btn-primary" type="submit">Sign up</button>
    <p class="meta">One short email when there is a new recipe. Unsubscribe any time.</p>
  </form>
</section>

<style>
  .form {
    display: grid;
    gap: var(--space-3);
    max-width: 26rem;
  }

  .meta {
    margin: 0;
  }
</style>
