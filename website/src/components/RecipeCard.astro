---
import { Image } from 'astro:assets';
import type { RecipeData } from '../lib/recipe-schema';
import { pillarLabel, recipeMetaLine } from '../lib/recipe-display';
import EffortBadge from './EffortBadge.astro';

interface Props {
  id: string;
  recipe: RecipeData;
}

const { id, recipe } = Astro.props;
---

<article class="card">
  <a class="stretch" href={`/recipes/${id}/`}>
    <Image
      class="photo"
      src={recipe.image as ImageMetadata}
      alt={recipe.imageAlt}
      width={600}
      height={400}
      widths={[300, 600]}
      sizes="(max-width: 48rem) 100vw, 360px"
      loading="lazy"
    />
    <div class="body">
      <p class="pillar">{pillarLabel(recipe.pillar)}</p>
      <h3>{recipe.title}</h3>
      <p class="meta">{recipeMetaLine(recipe)}</p>
      <EffortBadge label={recipe.effort} />
    </div>
  </a>
</article>

<style>
  .card {
    background: var(--surface);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow);
    border: 1px solid var(--border-subtle);
    overflow: hidden;
  }

  .stretch {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  /* Inset ring so the card's overflow: hidden cannot clip it. */
  .stretch:focus-visible {
    outline-offset: -3px;
  }

  .photo {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: var(--surface-alt);
  }

  .body {
    padding: var(--space-4) 1.25rem 1.25rem;
  }

  .pillar {
    font-size: var(--text-caption);
    font-weight: 700;
    color: var(--accent);
    margin: 0 0 var(--space-1);
  }

  h3 {
    font-size: var(--text-h4);
    margin-bottom: var(--space-1);
  }

  .meta {
    margin: 0 0 var(--space-2);
  }
</style>
