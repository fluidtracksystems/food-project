---
interface Props {
  items: { label: string; href: string }[];
}

const { items } = Astro.props;
---

<ul class="chips">
  {
    items.map((item) => (
      <li>
        <a href={item.href}>
          <span class="dot" aria-hidden="true">
            {item.label.charAt(0)}
          </span>
          {item.label}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .chips {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    width: 6.5rem;
    min-height: var(--target);
    text-align: center;
    text-decoration: none;
    color: var(--text);
    font-weight: 700;
    font-size: var(--text-small);
  }

  .dot {
    width: 5rem;
    height: 5rem;
    border-radius: var(--radius-pill);
    background: var(--surface-alt);
    border: 1px solid var(--border-subtle);
    display: grid;
    place-items: center;
    color: var(--muted);
    font-size: var(--text-h3);
    font-weight: 700;
  }

  a:hover .dot {
    background: var(--badge-bg);
  }
</style>
