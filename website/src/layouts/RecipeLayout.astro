---
import AuthorBox from '../components/AuthorBox.astro';
import EffortBadge from '../components/EffortBadge.astro';
import IngredientTable from '../components/IngredientTable.astro';
import PrintButton from '../components/PrintButton.astro';
import RecipeFacts from '../components/RecipeFacts.astro';
import { formatDate, updatedDate } from '../lib/recipe-display';
import type { RecipeData } from '../lib/recipe-schema';
import { AUTHOR_BOX_VARIANT } from '../lib/site';
import BaseLayout from './BaseLayout.astro';

interface Props {
  recipe: RecipeData;
  ogImage: string;
  noindex?: boolean;
}

const { recipe, ogImage, noindex = false } = Astro.props;
const updated = updatedDate(recipe);
---

<BaseLayout
  title={recipe.title}
  description={recipe.description}
  image={ogImage}
  noindex={noindex}
  type="article"
>
  <article class="recipe">
    <h1>{recipe.title}</h1>
    <p class="meta">
      <EffortBadge label={recipe.effort} /> &middot; Updated {formatDate(updated)}
    </p>
    <div class="row actions">
      <a class="btn btn-primary no-print" href="#ingredients">Jump to recipe</a>
      <PrintButton />
    </div>
    <div class="recipe-photo"><slot name="photo" /></div>
    <p>{recipe.description}</p>
    <RecipeFacts recipe={recipe} />
    <h2 id="ingredients">Ingredients</h2>
    <IngredientTable ingredients={recipe.ingredients} />
    <h2 class="method-heading">Method</h2>
    <ol class="steps">
      {recipe.steps.map((step) => <li><span>{step}</span></li>)}
    </ol>
    {
      recipe.leftoverNote && (
        <aside class="callout">
          <h2>Storing and reheating</h2>
          <p>{recipe.leftoverNote}</p>
        </aside>
      )
    }
    <div class="recipe-notes">
      <slot />
    </div>
    <AuthorBox variant={AUTHOR_BOX_VARIANT} author={recipe.author} updated={updated} />
  </article>
</BaseLayout>

<style is:global>
  .recipe {
    max-width: var(--content-max);
  }

  .recipe .actions {
    margin-bottom: var(--space-4);
  }

  .recipe-photo img {
    border-radius: var(--radius-md);
    display: block;
  }

  .recipe .method-heading {
    margin-top: var(--space-6);
  }

  .steps {
    padding-left: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .steps li::before {
    content: counter(step);
    font-weight: 800;
    font-size: var(--text-h3);
    color: var(--accent);
    line-height: 1.3;
  }

  .callout {
    background: var(--surface-alt);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
  }

  .callout h2 {
    font-size: var(--text-h4);
  }

  .callout p {
    margin: 0;
  }
</style>
