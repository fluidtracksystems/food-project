---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT_EMAIL } from '../lib/site';

const title = 'Contact';
const description = 'Ask a cooking question, tell us about a recipe, or report a problem with a kitchen calculator.';
---

<BaseLayout title={title} description={description}>
  <article class="prose contact-page">
    <h1>Get in touch</h1>
    <p>Have a question about a recipe, spotted a mistake, or have an idea for a kitchen calculator? Send us a message.</p>
    <p class="meta">We use your details to read and reply to your message. Read our <a href="/privacy/">privacy notice</a>.</p>

    <p role="status" aria-live="polite" aria-atomic="true" data-contact-status></p>
    <div class="notice" role="alert" tabindex="-1" data-contact-error hidden>
      <p data-error-copy></p>
      <p>Email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
    </div>
    <section class="notice" tabindex="-1" aria-labelledby="contact-success-heading" data-contact-success hidden>
      <h2 id="contact-success-heading">Thanks for your message</h2>
      <p>We will reply to the email address you gave us.</p>
      <button type="button" class="btn btn-secondary">Send another message</button>
    </section>

    <form class="contact-form" action="/api/contact.php" method="post" enctype="application/x-www-form-urlencoded" data-contact-form data-contact-email={CONTACT_EMAIL}>
      <div>
        <label for="contact-name">Name <span class="meta">(required)</span></label>
        <input id="contact-name" name="name" type="text" autocomplete="name" required maxlength="100" aria-describedby="contact-name-hint contact-name-error" />
        <p class="meta" id="contact-name-hint">One line, up to 100 characters.</p>
        <p class="field-error" id="contact-name-error"></p>
      </div>
      <div>
        <label for="contact-email">Email address <span class="meta">(required)</span></label>
        <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="contact-email-hint contact-email-error" />
        <p class="meta" id="contact-email-hint">The address where you would like our reply, up to 254 characters.</p>
        <p class="field-error" id="contact-email-error"></p>
      </div>
      <div>
        <label for="contact-message">Message <span class="meta">(required)</span></label>
        <textarea id="contact-message" name="message" rows="7" required maxlength="5000" aria-describedby="contact-message-hint contact-message-error"></textarea>
        <p class="meta" id="contact-message-hint">Up to 5,000 characters. If something went wrong, include the page and what happened.</p>
        <p class="field-error" id="contact-message-error"></p>
      </div>
      <div class="visually-hidden" aria-hidden="true">
        <label for="contact-hp">Leave this field empty</label>
        <input id="contact-hp" type="text" name="hp_check" value="" tabindex="-1" autocomplete="off" />
      </div>
      <button class="btn btn-primary" type="submit" disabled>Send message</button>
    </form>
    <noscript><p>This form needs JavaScript to send your message. Please email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> instead.</p></noscript>
    <p class="email-alternative">Prefer email? Write to <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
  </article>
  <script>
    import '../scripts/contact';
  </script>
</BaseLayout>

<style>
  .contact-page { padding-top: var(--space-8); }
  .contact-form { display: grid; gap: var(--space-6); }
  .contact-form[hidden] { display: none; }
  .contact-form .meta { margin: var(--space-1) 0 0; }
  textarea {
    display: block;
    width: 100%;
    min-height: 10rem;
    resize: vertical;
    border: 2px solid var(--border-strong);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    font: inherit;
    background: var(--surface);
    color: var(--text);
  }
  [aria-invalid='true'] { border-color: var(--accent); }
  .field-error { font-weight: 700; margin: var(--space-1) 0 0; }
  .field-error:empty { display: none; }
  .notice { padding: var(--space-4); margin-bottom: var(--space-6); background: var(--surface-alt); border: 2px solid var(--border-strong); border-radius: var(--radius-md); }
  .notice p:last-child { margin-bottom: 0; }
  .btn { justify-self: start; }
  .btn:disabled { cursor: wait; }
  .email-alternative { margin-top: var(--space-6); overflow-wrap: anywhere; }
</style>
