---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveSignupAction } from '../lib/email';
import { privacyProblems } from '../lib/privacy';
import { CONTACT_EMAIL, EMAIL_PROVIDER_NAME, LEGAL_UPDATED } from '../lib/site';

const title = 'Privacy notice';
const description =
  'What this site does and does not collect about you, how the optional email list works, and how to reach us with a privacy question.';

const endpoint = resolveSignupAction(import.meta.env.PUBLIC_EMAIL_FORM_ACTION);
const problems = privacyProblems({ signupEndpoint: endpoint, providerName: EMAIL_PROVIDER_NAME, contactEmail: CONTACT_EMAIL });
// Fail the build rather than publish a notice that cannot describe what the site collects.
if (problems.length > 0) {
  throw new Error(`The privacy page cannot be built:\n- ${problems.join('\n- ')}`);
}
const provider = EMAIL_PROVIDER_NAME?.trim();
const contact = CONTACT_EMAIL?.trim();
---

<BaseLayout title={title} description={description}>
  <!-- TODO(legal): have this notice reviewed before launch, including US state privacy law requirements. -->
  <article class="prose">
    <h1>{title}</h1>
    <p class="meta">Last updated {LEGAL_UPDATED}.</p>

    <h2>The short version</h2>
    <p>
      This site currently has no accounts and no advertising, and it does not set cookies. The calculators work in your browser:
      what you type into them is not sent to us and is not stored.
    </p>

    <h2>What we collect</h2>
    <ul>
      <li>
        <strong>Visitor statistics:</strong> none. The site does not currently use an analytics service. If one is added,
        this page will be updated before it goes live.
      </li>
      <li>
        <strong>Server logs:</strong> like any website, the company that hosts this site's files may keep standard server
        logs, such as your IP address and the pages you asked for.
      </li>
      {
        endpoint && (
          <li>
            <strong>Email list:</strong> if you sign up, we collect the email address you type into the form. We use it
            only to send you an email when there is a new recipe. It is held by {provider}, which sends the emails for us.
            You can unsubscribe at any time, and to have your address removed you can write to <a href={`mailto:${contact}`}>{contact}</a>.
          </li>
        )
      }
    </ul>

    <h2>Links to other sites</h2>
    <p>
      Some pages may link to other sites, such as social media. Those sites have their own privacy practices, and we do
      not control them.
    </p>

    <h2>Children</h2>
    <p>
      This site is meant for adults. It is not directed at children under 13, and we do not knowingly collect
      information from them.
    </p>

    {
      contact && (
        <>
          <h2>Your choices and how to reach us</h2>
          <p>
            To ask a privacy question, or to have your email address removed, write to <a href={`mailto:${contact}`}>{contact}</a>.
          </p>
        </>
      )
    }

    <h2>Changes</h2>
    <p>If this notice changes, we will update this page and the date at the top.</p>
  </article>
</BaseLayout>
